{
  "name": "TG-BOT Send message",
  "nodes": [
    {
      "parameters": {
        "jsCode": "// items — все строки таблицы\n// Ищем первую строку, которая полностью не обработана:\n// TEST# есть, ACTUAL_RESULT пустой, SENDED пустой\n\nconst nextToSend = items.find(item =>\n    item.json['TEST#'] &&\n    !item.json.ACTUAL_RESULT &&\n    !item.json.SENDED\n);\n\n// Ищем строку, где SENDED уже есть, а ACTUAL_RESULT нет\nconst waitingForResult = items.find(item =>\n    item.json['TEST#'] &&\n    !item.json.ACTUAL_RESULT &&\n    item.json.SENDED\n);\n\n// Если есть строка, которая уже отправлена, но без результата — СТОП\nif (waitingForResult) {\n    return []; // не отправляем НИЧЕГО\n}\n\n// Если есть строка, которую нужно отправить — отправляем\nif (nextToSend) {\n    return [ nextToSend ];\n}\n\n// Иначе — ничего не делаем\nreturn [];\n"
      },
      "type": "n8n-nodes-base.code",
